# .env.example — template for environment configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your own values.
# This file IS committed to GitHub (it contains no real secrets).
#
#   cp .env.example .env

# ---- Model weights ----
# Paths to your trained YOLOv8s weights (.pt files).
# Relative paths are resolved from the project root.
RAW_MODEL_WEIGHTS=models/raw_best.pt
PREP_MODEL_WEIGHTS=models/prep_best.pt

# ---- Inference device ----
# "cpu" for CPU inference (default).
# "0"   for first CUDA GPU.
INFER_DEVICE=cpu

# ---- Upload limit (MB) ----
MAX_UPLOAD_MB=20
