# .env — local environment configuration
# ----------------------------------------
# This file is listed in .gitignore and will NOT be committed to GitHub.
# Each developer/user creates their own copy from .env.example
#
# HOW TO SET UP:
#   1. Copy .env.example to .env
#   2. Fill in the paths to your trained model weights
#   3. Never commit this file

# ---- Model weights (absolute or relative paths) ----
# Place your trained .pt files here and update the paths below.
# Relative paths are relative to the project root folder.
RAW_MODEL_WEIGHTS=models/raw_best.pt
PREP_MODEL_WEIGHTS=models/prep_best.pt

# ---- Inference device ----
# "cpu"  → run on CPU (default, works everywhere)
# "0"    → use first CUDA GPU (requires torch with CUDA)
INFER_DEVICE=cpu

# ---- Upload limit (MB) ----
MAX_UPLOAD_MB=20
